{
  "name": "o2h",
  "version": "0.0.20",
  "description": "Convert JavaScript Object into canonical HTML",
  "type": "module",
  "main": "o2h.js",
  "module": "o2h.js",
  "keywords": [
    "html",
    "object",
    "transformer"
  ],
  "files": [
    "o2h.js",
    "o2h.ts",
    "types/o2h/types.d.ts",
    "README.md",
    "LICENSE",
    "o2h-sw.js",
    "worker/*.js",
    "worker/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./types/o2h/types.d.ts",
      "default": "./o2h.js"
    },
    "./o2h.js": {
      "types": "./types/o2h/types.d.ts",
      "default": "./o2h.js"
    },
    "./worker/client.js": {
      "types": "./worker/client.ts",
      "default": "./worker/client.js"
    },
    "./worker/core.js": {
      "types": "./worker/core.ts",
      "default": "./worker/core.js"
    },
    "./o2h-sw.js": "./o2h-sw.js"
  },
  "types": "types/o2h/types.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "build:worker": "node worker/build.mjs",
    "serve": "node ./node_modules/spa-ssi/serve.js",
    "test": "playwright test",
    "package-check": "package-check",
    "safari": "npx playwright wk http://localhost:8000",
    "update": "ncu -u && npm install"
  },
  "dependencies": {
    "assign-gingerly": "0.0.104"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "^0.28.2",
    "spa-ssi": "0.0.28"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bahrus/o2h.git"
  },
  "author": "anderson.bruce.b@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bahrus/o2h/issues"
  },
  "homepage": "https://github.com/bahrus/o2h#readme"
}
