{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"sourceMap": false,
		"newLine": "LF",
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"o2h.ts",
		"worker/*.ts",
		"types/o2h/types.d.ts"
	],
	"exclude": [
		"node_modules",
		"legacy"
	]
}
